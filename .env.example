# Variáveis de Ambiente do Super Admin Backoffice
VITE_API_URL=http://localhost:3333/api/v1
VITE_API_TIMEOUT=15000
VITE_ENABLE_MOCK_FALLBACK=true

# Sentry (vazio = SDK desligado). Em CD, mapear secret VITE_SENTRY_DSN_BACKOFFICE → VITE_SENTRY_DSN
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=drivesync@git-sha
#
# Upload de source maps no build (VPS/.sentry.env ou CI):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=drivesyncme
# SENTRY_PROJECT=drivesync-backoffice
